{
  "$schema": "https://opencode.ai/config.json",
  // OpenCode 2, native v2 format. Local models on the NAS through llama-swap (OpenAI format).
  // Goes to ~/.config/opencode/opencode.jsonc. Replace NAS-ADDRESS and PORT with llama-swap's address.
  "model": "nas/faber",
  "agents": {
    // Session titles with the same model as the work, otherwise llama-swap reloads for every title
    "title": { "model": "nas/faber" }
  },
  "share": "disabled",
  "providers": {
    "nas": {
      "name": "NAS (llama-swap)",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://NAS-ADDRESS:PORT/v1",
        "apiKey": "none",
        // long prompts take a while to read; without this the client gives up first
        "timeout": 600000
      },
      "models": {
        "faber": { "name": "Qwen3.8 Flash-Next 125B IQ3_XXS", "limit": { "context": 262144, "output": 32768 } },
        "velox": { "name": "Qwen3.8 Flash-Next 125B IQ2_XS", "limit": { "context": 262144, "output": 32768 } },
        "liber": { "name": "Qwen3.8 Flash-Next 125B IQ3_XXS, uncensored", "limit": { "context": 262144, "output": 32768 },
                   "capabilities": { "input": ["text", "image"] } }
      }
    }
  }
}
