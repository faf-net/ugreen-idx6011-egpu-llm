# Adresse des NAS im Heimnetz (nicht 0.0.0.0: Docker würde den Port sonst an jeder Schnittstelle öffnen)
ADRESSE=192.168.1.10
PORT=3000
# llama-swap, ohne /v1 am Ende. llama-swap lauscht an der Adresse des NAS, nicht an localhost.
LLAMA_SWAP_URL=http://192.168.1.10:8090
# nur nötig, wenn llama-swap Schlüssel prüft
LLAMA_SWAP_KEY=keiner
# beliebige lange Zufallsfolge, z. B. aus: openssl rand -hex 32
SEARXNG_SECRET=bitte-ersetzen
NAME=NAS Chat
SPRACHE=de-DE
ZEITZONE=Europe/Berlin
